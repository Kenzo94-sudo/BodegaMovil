<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".catalogo_limpieza">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_limpieza"
            android:layout_width="match_parent"
            android:layout_height="199dp"
            android:orientation="vertical"
            app:cardBackgroundColor="@color/orange_low"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/img_menu"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/icon_menu"
                        app:layout_constraintStart_toStartOf="parent" />

                    <ImageView
                        android:id="@+id/img_cerrar"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/icon_close"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/titulo_limpieza"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/titulo_limpieza"
                        style="@style/titulos"/>


                    <androidx.appcompat.widget.SearchView
                        android:id="@+id/searchView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:queryHint="Buscar limpieza..."
                        android:background="@drawable/searchview_background"
                        android:layout_marginTop="5dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registrar"
                        android:textSize="15dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Eliminar"
                        android:textSize="15dp"
                        android:layout_weight="1" />

                </LinearLayout>
            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_limpieza_categoria"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:orientation="vertical"
            android:elevation="5dp"
            app:layout_constraintBottom_toTopOf="@+id/ll_buttons"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cv_limpieza">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_jabon"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:orientation="horizontal"
                    android:weightSum="7"
                    android:background="@drawable/rounded_layout"
                    app:layout_constraintBottom_toTopOf="@+id/ll_buttons"
                    app:layout_constraintTop_toTopOf="@+id/cv_limpieza_categoria">

                    <ImageView
                        android:id="@+id/img_jabon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:src="@drawable/jabon_limpieza"
                        app:layout_constraintStart_toStartOf="@+id/ll_jabon"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:background="@drawable/circle_imageview" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="4"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nombre_producto"
                            style="@style/clave_producto"
                            android:layout_gravity="start"
                            android:layout_marginTop="5dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/limpieza_jabon"
                            style="@style/valor_producto"
                            android:layout_gravity="center"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/descripcion"
                            style="@style/clave_producto"
                            android:layout_gravity="start"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/descripcion_jabon"
                            style="@style/valor_producto"
                            android:layout_gravity="center"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cantidad"
                            style="@style/clave_producto"
                            android:layout_gravity="start"/>


                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_detergente"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:orientation="horizontal"
                    android:weightSum="7"
                    android:background="@drawable/rounded_layout">

                    <ImageView
                        android:id="@+id/img_detergente"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:src="@drawable/detergente_limpieza"
                        app:layout_constraintStart_toStartOf="@+id/ll_detergente"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:layout_margin="3dp"
                        android:background="@drawable/circle_imageview" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="4"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nombre_producto"
                            style="@style/clave_producto"
                            android:layout_gravity="start"
                            android:layout_marginTop="5dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/limpieza_detergente"
                            style="@style/valor_producto"
                            android:layout_gravity="center"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/descripcion"
                            style="@style/clave_producto"
                            android:layout_gravity="start"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/descripcion_detergente"
                            style="@style/valor_producto"
                            android:layout_gravity="center"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cantidad"
                            style="@style/clave_producto"
                            android:layout_gravity="start"/>


                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_shampoo"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:orientation="horizontal"
                    android:weightSum="7"
                    android:background="@drawable/rounded_layout">

                    <ImageView
                        android:id="@+id/img_shampoo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:src="@drawable/shampoo_limpieza"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:layout_margin="3dp"
                        app:layout_constraintStart_toStartOf="@+id/ll_shampoo"
                        android:background="@drawable/circle_imageview" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="4"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nombre_producto"
                            style="@style/clave_producto"
                            android:layout_gravity="start"
                            android:layout_marginTop="5dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/limpieza_shampoo"
                            style="@style/valor_producto"
                            android:layout_gravity="center"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/descripcion"
                            style="@style/clave_producto"
                            android:layout_gravity="start"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/descripcion_shampoo"
                            style="@style/valor_producto"
                            android:layout_gravity="center"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cantidad"
                            style="@style/clave_producto"
                            android:layout_gravity="start"/>


                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/ll_buttons"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/cv_limpieza_categoria"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@id/btnAtras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Atras"
                android:textSize="20dp"
                android:backgroundTint="@color/orange_red"/>
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

